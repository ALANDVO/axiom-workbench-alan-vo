# Environment variables for Axiom Workbench
# Copy this file to .env and fill in your values

# Application
APP_NAME=axiom-workbench
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./axiom.db
DATABASE_ECHO=false

# Security (REQUIRED: generate a strong secret for production!)
# openssl rand -hex 32
SECRET_KEY=dev-secret-change-in-production-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated for production)
CORS_ORIGINS=http://localhost:5173,http://localhost

# Model Storage
MODELS_DIR=/app/models
MAX_UPLOAD_SIZE=53687091200

# Keycloak / OIDC (optional, for auth feature)
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=axiom
# KEYCLOAK_CLIENT_ID=axiom-workbench
# KEYCLOAK_CLIENT_SECRET=

# LLM Providers (optional, for llm-adapters feature)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_API_KEY=
# LLM_BASE_URL=